# You do NOT need this file to deploy — GitHub Actions reads these from
# Settings → Secrets and variables → Actions → Variables (see README).
# It documents every setting and lets anyone who does run locally copy it to .env.local.

# --- Firebase web config (public by design; Security Rules protect the data) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Force the in-browser demo backend even when Firebase is configured: demo
VITE_BACKEND=

# --- UPI payments (manual verification) ---
VITE_UPI_VPA=yourname@okaxis
VITE_UPI_PAYEE_NAME=Sadhana Sanskritam

# --- Contact ---
VITE_CONTACT_EMAIL=hello@example.org
VITE_CONTACT_WHATSAPP=+919876543210
VITE_WHATSAPP_CHANNEL_URL=
VITE_ADMIN_ALERT_EMAIL=

# --- EmailJS (free: 200 emails/month) ---
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_MONTHLY_QUOTA=200
VITE_EMAIL_BATCH_SIZE=10
VITE_EMAIL_BATCH_DELAY_MS=1500

# --- Provider switches (future upgrades) ---
# manual-upi | razorpay
VITE_PAYMENT_PROVIDER=manual-upi
# emailjs | console | server
VITE_EMAIL_PROVIDER=
# wa-me | cloud-api
VITE_WHATSAPP_PROVIDER=wa-me
# firestore-rules | signed-url
VITE_ACCESS_PROVIDER=firestore-rules

# --- Feature flags (true/false) ---
VITE_FLAG_INTRO=true
VITE_FLAG_ASSISTANT=true
VITE_FLAG_AMBIENT=true
VITE_FLAG_EMAIL_LINK=true
VITE_FLAG_GOOGLE=true
VITE_FLAG_ONLINE_PAYMENTS=false
VITE_FLAG_WHATSAPP_CLOUD_API=false

# --- Build (set automatically by the deploy workflow) ---
BASE_PATH=/
VITE_SITE_URL=
